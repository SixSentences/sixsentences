# Generate a private .env.selfhost with deploy/community/init-env.sh.
# Never put real credentials in this example or commit the generated file.
SIX_DEPLOYMENT_MODE=tls
SIX_ALLOW_INSECURE_LOCAL_HTTP=false
SIX_SITE_ADDRESS=research.example.invalid
SIX_PUBLIC_ORIGIN=https://research.example.invalid
SIX_PUBLIC_API_URL=https://research.example.invalid/api
SIX_LEGAL_BASE_URL=https://research.example.invalid/legal
SIX_HTTP_PORT=80
SIX_HTTPS_PORT=443

# Generated locally. The preflight rejects these instructional placeholders.
POSTGRES_PASSWORD=GENERATE_WITH_INIT_SCRIPT
SIX_CONNECTOR_ENCRYPTION_KEY=GENERATE_WITH_INIT_SCRIPT
SIX_ERASURE_LEDGER_HMAC_KEY=GENERATE_WITH_INIT_SCRIPT

# The web image embeds these non-secret values at build time.
SIX_TERMS_VERSION=community-1
SIX_PRIVACY_VERSION=community-1
SIX_DPA_VERSION=community-1
SIX_GOOGLE_OAUTH_CLIENT_ID=
SIX_BROWSER_CAPTURE_REDIRECT_URIS=

# Registration is closed until mail delivery and notices are ready.
SIX_SELF_SIGNUP=false
SIX_REQUIRE_EMAIL_VERIFICATION=true
SIX_ENFORCE_LEGAL_ACCEPTANCE=true
SIX_SMTP_HOST=
SIX_SMTP_PORT=587
SIX_SMTP_USERNAME=
SIX_SMTP_PASSWORD=
SIX_SMTP_STARTTLS=true
SIX_MAIL_FROM=community@example.invalid
SIX_MAIL_REPLY_TO=community@example.invalid

# Scholarly metadata and optional document extraction.
SIX_OPENALEX_API_KEY=
SIX_OPENALEX_MAILTO=researcher@example.invalid
SIX_GROBID_URL=

# Optional model/search provider. No key means no provider egress.
SIX_OPENROUTER_API_KEY=
SIX_OPENROUTER_BASE_URL=https://model-provider.example.invalid/v1
SIX_WEBSEARCH_API_KEY=
SIX_WEBSEARCH_DATA_PROCESSING_CONFIRMED=false
SIX_LLM_ROUTING=
SIX_LLM_BUDGET_USD=10

# Optional spoken interviews. All three gates must be deliberate.
SIX_GEMINI_API_KEY=
SIX_GEMINI_PAID_SERVICE_CONFIRMED=false
SIX_PUBLIC_SPOKEN_INTERVIEWS_ENABLED=false

# Local capacity/safety settings.
SIX_WORKER_CONCURRENCY=2
SIX_STORAGE_RESERVE_BYTES=1073741824
SIX_REPOSITORY_ANALYSIS_ENABLED=true

# Backups must live outside the checkout.
SIX_BACKUP_DIR=/absolute/path/outside/the/repository
