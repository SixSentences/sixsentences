# Copy to .env and replace every CHANGE_ME value. Never commit .env.
POSTGRES_DB=sixsentences
POSTGRES_USER=sixsentences
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
SIX_DATABASE_URL=postgresql+psycopg://sixsentences@postgres:5432/sixsentences
SIX_DATA_DIR=/data
SIX_SELF_SIGNUP=false
SIX_REQUIRE_EMAIL_VERIFICATION=true
SIX_ENFORCE_LEGAL_ACCEPTANCE=false
SIX_JOBS_BACKEND=database
SIX_JOBS_HEARTBEAT_DIR=/tmp
SIX_RATE_LIMIT_BACKEND=database
SIX_CONNECTOR_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
SIX_ERASURE_LEDGER_HMAC_KEY=CHANGE_ME_ERASURE_HMAC_KEY
SIX_ERASURE_LEDGER_PATH=/privacy/erasure-ledger.jsonl
SIX_APP_URL=http://localhost:3000
SIX_SITE_URL=http://localhost:3000
SIX_PRIVACY_NOTICE_URL=http://localhost:3000/privacy
SIX_TERMS_URL=http://localhost:3000/terms
SIX_DOCS_URL=http://localhost:3000/docs
SIX_CORS_ORIGINS=http://localhost:3000
SIX_OPENALEX_MAILTO=
SIX_SMTP_HOST=
SIX_MAIL_FROM="SixSentences <noreply@localhost>"
SIX_GEMINI_API_KEY=
SIX_GEMINI_DATA_PROCESSING_CONFIRMED=false
SIX_PUBLIC_SPOKEN_INTERVIEWS_ENABLED=false
SIX_OPENROUTER_API_KEY=
SIX_WEBSEARCH_DATA_PROCESSING_CONFIRMED=false
