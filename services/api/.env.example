# Load these values through your process manager or secret manager.
# The application does not automatically read this file.
SIX_COMMUNITY_ENVIRONMENT=development
SIX_COMMUNITY_DATABASE_URL=sqlite:////data/community.sqlite3
SIX_COMMUNITY_AUTO_CREATE_SCHEMA=false
SIX_COMMUNITY_REGISTRATION_ENABLED=true
SIX_COMMUNITY_ALLOWED_HOSTS=["localhost","127.0.0.1"]
SIX_COMMUNITY_ALLOWED_ORIGINS=[]
SIX_COMMUNITY_SESSION_HOURS=168
SIX_COMMUNITY_MAX_UPLOAD_BYTES=26214400

SIX_COMMUNITY_SMTP_HOST=
SIX_COMMUNITY_SMTP_PORT=587
SIX_COMMUNITY_SMTP_STARTTLS=true
SIX_COMMUNITY_SMTP_USERNAME=
SIX_COMMUNITY_SMTP_PASSWORD=
SIX_COMMUNITY_SMTP_FROM=community@example.invalid

SIX_COMMUNITY_AI_PROVIDER=disabled
SIX_COMMUNITY_AI_BASE_URL=
SIX_COMMUNITY_AI_API_KEY=
SIX_COMMUNITY_AI_MODEL=

SIX_COMMUNITY_VOICE_PROVIDER=disabled
SIX_COMMUNITY_VOICE_BASE_URL=
SIX_COMMUNITY_VOICE_API_KEY=
SIX_COMMUNITY_VOICE_MODEL=

SIX_COMMUNITY_OPENALEX_MAILTO=
SIX_COMMUNITY_OPENALEX_API_KEY=
