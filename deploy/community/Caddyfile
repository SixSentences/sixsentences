{
	admin off
}

{$SIX_SITE_ADDRESS} {
	@api path /api /api/*
	handle @api {
		# Match the API's largest accepted request and keep long-lived event
		# streams unbuffered. Compression is deliberately web-only below.
		request_body {
			max_size 167772160
		}
		uri strip_prefix /api
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				read_timeout 3600s
				write_timeout 3600s
			}
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), geolocation=(), usb=()"
	}
}
