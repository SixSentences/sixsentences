# Public browser configuration. Never place server-side secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_SIX_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LEGAL_BASE_URL=http://localhost:3000

# Optional OAuth client identifier (public by design). Leave empty to hide Google sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional public installation page for the browser-capture companion.
NEXT_PUBLIC_BROWSER_CAPTURE_STORE_URL=
